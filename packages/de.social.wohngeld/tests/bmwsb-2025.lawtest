        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:mietverhaeltnis"), 335.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:haushalt")) { origin adjudicated; }
        assert "rentnerin-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:rentnerin")) { origin case_input; }
        assert "rentnerin-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:rentnerin"), KEIN_AUSLAENDER) { origin case_input; }
        assert "rentnerin-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:rentnerin"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "rentnerin-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:rentnerin"), NEIN, JA, NEIN) { origin case_input; }
        assert "rentnerin-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:rentnerin")) { origin case_input; }
        assert "rentnerin-rente": de.tax.income_for_wohngeld::leibrente_gesetzliche_rentenversicherung(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:rentnerin"), 15600.00 EUR, 7800.00 EUR) { origin case_input; }
        assert "rentnerin-werbungskosten-rente": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_sonstige(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:rentnerin"), 0.00 EUR) { origin case_input; }
    }
    evaluate truth(monatliches_gesamteinkommen(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:haushalt"), 1162.35 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01b:haushalt"), 110 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// PDF BMWSB «Beispiele für die Berechnung des Wohngelds», Stand 1. Januar 2025, Rechenbeispiel 2 (фрагмент BMWSB_2025_BSP2). ALG I 1 350,00 без вычетов (§ 14 Abs. 2 Nr. 6; «kein Arbeitnehmer-Pauschbetrag»); Miete 470,00 + 110,40.
test "BMWSB 2025 Rechenbeispiel 2: Alleinstehender mit ALG I, Ludwigshafen am Rhein (Mietenstufe IV) — 88 EUR" {
    given {
        context { legal_time @2025-01-01; decision_time @2025-01-01T09:00:00Z; knowledge_time @2025-01-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:alleinstehender"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:alleinstehender"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:haushalt"), "Rheinland-Pfalz", "Ludwigshafen am Rhein, Stadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:mietverhaeltnis"), 470.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:haushalt")) { origin adjudicated; }
        assert "alleinstehender-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:alleinstehender")) { origin case_input; }
        assert "alleinstehender-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:alleinstehender"), KEIN_AUSLAENDER) { origin case_input; }
        assert "alleinstehender-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:alleinstehender"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "alleinstehender-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:alleinstehender"), NEIN, NEIN, NEIN) { origin case_input; }
        assert "alleinstehender-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:alleinstehender")) { origin case_input; }
        assert "alleinstehender-alg1": de.tax.income_for_wohngeld::arbeitslosengeld_sgb3(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:alleinstehender"), 16200.00 EUR) { origin case_input; }
    }
    evaluate truth(monatliches_gesamteinkommen(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:haushalt"), 1350.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(zu_beruecksichtigende_miete(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:haushalt"), 580.40 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(hoechstbetrag_mit_klimakomponente(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:haushalt"), 530.20 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:bmwsb-2025-02:haushalt"), 88 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// PDF BMWSB «Beispiele für die Berechnung des Wohngelds», Stand 1. Januar 2025, Rechenbeispiel 3 (фрагмент BMWSB_2025_BSP3). 1 231,35 + 478,35 − 150,00 (Freibetrag § 17 Nr. 1, 1 800 €/Jahr) = 1 589,70; Miete 480 + 142,60.
test "BMWSB 2025 Rechenbeispiel 3: Ehepaar mit Renten, Ehemann GdB 100, Leipzig (Mietenstufe II) — 166 EUR" {
    given {
        context { legal_time @2025-01-01; decision_time @2025-01-01T09:00:00Z; knowledge_time @2025-01-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehemann"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehemann"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt"), "Sachsen", "Leipzig, Stadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:mietverhaeltnis"), 480.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt")) { origin adjudicated; }
        assert "ehemann-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehemann")) { origin case_input; }
        assert "ehemann-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehemann"), KEIN_AUSLAENDER) { origin case_input; }
        assert "ehemann-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehemann"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "ehemann-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehemann"), NEIN, JA, NEIN) { origin case_input; }
        assert "ehemann-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehemann")) { origin case_input; }
        assert "ehemann-rente": de.tax.income_for_wohngeld::leibrente_gesetzliche_rentenversicherung(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehemann"), 16920.00 EUR, 13536.00 EUR) { origin case_input; }
        assert "ehemann-werbungskosten-rente": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_sonstige(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehemann"), 0.00 EUR) { origin case_input; }
        assert "ehemann-gdb": schwerbehinderung(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehemann"), 100) { origin case_input; }
        assert "ehefrau-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehefrau")) { origin case_input; }
        assert "ehefrau-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehefrau"), KEIN_AUSLAENDER) { origin case_input; }
        assert "ehefrau-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehefrau"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "ehefrau-beziehung": beziehung(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehefrau"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehemann"), EHEGATTE_NICHT_DAUERND_GETRENNT) { origin case_input; }
        assert "ehefrau-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehefrau"), NEIN, JA, NEIN) { origin case_input; }
        assert "ehefrau-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehefrau")) { origin case_input; }
        assert "ehefrau-rente": de.tax.income_for_wohngeld::leibrente_gesetzliche_rentenversicherung(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehefrau"), 6480.00 EUR, 5184.00 EUR) { origin case_input; }
        assert "ehefrau-werbungskosten-rente": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_sonstige(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:ehefrau"), 0.00 EUR) { origin case_input; }
    }
    evaluate truth(monatliches_gesamteinkommen(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt"), 1589.70 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(zu_beruecksichtigende_miete(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt"), 622.60 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(hoechstbetrag_mit_klimakomponente(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt"), 517.80 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:bmwsb-2025-03:haushalt"), 166 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// PDF BMWSB «Beispiele für die Berechnung des Wohngelds», Stand 1. Januar 2025, Rechenbeispiel 5 (фрагмент BMWSB_2025_BSP5). 1 427,50 − 20 % = 1 142,00; Unterhaltsvorschuss 696,00 (в PDF общей суммой; делу разнесено поровну — итог не меняется);
// Freibetrag § 17 Nr. 3 (1 320 €/Jahr) = 110,00; Miete 700 + 170,20. Anlage пишет «Wiesbaden, Landeshaupstadt».
test "BMWSB 2025 Rechenbeispiel 5: Alleinerziehende mit zwei Kindern, Wiesbaden (Mietenstufe VI) — 372 EUR" {
    given {
        context { legal_time @2025-01-01; decision_time @2025-01-01T09:00:00Z; knowledge_time @2025-01-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:bmwsb-2025-05:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-05:mutter"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:bmwsb-2025-05:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-05:mutter"), MIETVERHAELTNIS) { origin case_input; }
