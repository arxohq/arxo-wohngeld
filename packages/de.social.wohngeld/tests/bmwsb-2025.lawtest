language "law.core" version "0.2";
package de.social.wohngeld version "0.1.0";
namespace "urn:de:social:clir:wohngeld";

// Официальные примеры BMWSB 2025 года: 9 арендных из 11 (№ 4, № 11 — Lastenzuschuss).
// Ожидания — числа PDF; допущения дела названы в комментарии к сценарию.

// PDF BMWSB «Beispiele für die Berechnung des Wohngelds», Stand 1. Januar 2025, Rechenbeispiel 1 (фрагмент BMWSB_2025_BSP1). Rente 1 300,00 − 8,50 = 1 291,50; −10 % → 1 162,35; Miete 335,00 + 110,40 = 445,40; Höchstbetrag 361 + 19,20.
test "BMWSB 2025 Rechenbeispiel 1: alleinstehende Rentnerin, Jüterbog (Mietenstufe I) — 110 EUR" {
    given {
        context { legal_time @2025-01-01; decision_time @2025-01-01T09:00:00Z; knowledge_time @2025-01-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:rentnerin"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:rentnerin"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt"), "Brandenburg", "Jüterbog, Stadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:mietverhaeltnis"), 335.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt")) { origin adjudicated; }
        assert "rentnerin-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:rentnerin")) { origin case_input; }
        assert "rentnerin-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:rentnerin"), KEIN_AUSLAENDER) { origin case_input; }
        assert "rentnerin-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:rentnerin"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "rentnerin-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:rentnerin"), NEIN, JA, NEIN) { origin case_input; }
        assert "rentnerin-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:rentnerin")) { origin case_input; }
        assert "rentnerin-rente": de.tax.income_for_wohngeld::leibrente_gesetzliche_rentenversicherung(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:rentnerin"), 15600.00 EUR, 12480.00 EUR) { origin case_input; }
        assert "rentnerin-werbungskosten-rente": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_sonstige(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:rentnerin"), 0.00 EUR) { origin case_input; }
    }
    evaluate truth(monatliches_gesamteinkommen(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt"), 1162.35 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(zu_beruecksichtigende_miete(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt"), 445.40 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(hoechstbetrag_mit_klimakomponente(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt"), 380.20 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt"), 110 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeldanspruch(entity_ref("urn:de:example:wohngeld:bmwsb-2025-01:haushalt"), 110 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect judgment_requests(0);
}

// PDF BMWSB «Beispiele für die Berechnung des Wohngelds», Stand 1. Januar 2025, Rechenbeispiel 1 (фрагмент BMWSB_2025_BSP1). Та же сумма при другой облагаемой части: допущение 80 % в прочих сценариях на итог не влияет.
