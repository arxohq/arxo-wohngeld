        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:kind25:haushalt")) { origin adjudicated; }
        assert "vater-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:kind25:haushalt"), entity_ref("urn:de:example:wohngeld:kind25:vater")) { origin case_input; }
