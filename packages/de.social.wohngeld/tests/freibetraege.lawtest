        assert "vater-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:kind25:vater")) { origin case_input; }
        assert "vater-lohn": de.tax.income_for_wohngeld::arbeitslohn_in_geld(entity_ref("urn:de:example:wohngeld:kind25:vater"), 33000.00 EUR) { origin case_input; }
        assert "vater-werbungskosten": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_arbeit(entity_ref("urn:de:example:wohngeld:kind25:vater"), 0.00 EUR) { origin case_input; }
        assert "kind-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:kind25:haushalt"), entity_ref("urn:de:example:wohngeld:kind25:kind")) { origin case_input; }
