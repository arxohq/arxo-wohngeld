language "law.core" version "0.2";
package de.social.wohngeld version "0.1.0";
namespace "urn:de:social:clir:wohngeld";

// Freibeträge § 17, Unterhalt § 18, состав Miete через WoGV.

// Состав BMWSB 2025 № 3: 1 231,35 + 478,35 = 1 739,70; Freibetrag 150,00 в месяц.
test "§ 17 Nr. 1 b: GdB 80 mit Pflegebedürftigkeit und häuslicher Pflege — 1 800 EUR" {
    given {
        context { legal_time @2025-03-01; decision_time @2025-03-01T09:00:00Z; knowledge_time @2025-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:gdb80-pflege:haushalt"), entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehemann"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:gdb80-pflege:haushalt"), entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehemann"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:gdb80-pflege:haushalt"), "Sachsen", "Leipzig, Stadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:gdb80-pflege:haushalt"), entity_ref("urn:de:example:wohngeld:gdb80-pflege:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:gdb80-pflege:mietverhaeltnis"), 480.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:gdb80-pflege:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:gdb80-pflege:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:gdb80-pflege:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:gdb80-pflege:haushalt")) { origin adjudicated; }
        assert "ehemann-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:gdb80-pflege:haushalt"), entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehemann")) { origin case_input; }
        assert "ehemann-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehemann"), KEIN_AUSLAENDER) { origin case_input; }
        assert "ehemann-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehemann"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "ehemann-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehemann"), NEIN, JA, NEIN) { origin case_input; }
        assert "ehemann-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehemann")) { origin case_input; }
        assert "ehemann-rente": de.tax.income_for_wohngeld::leibrente_gesetzliche_rentenversicherung(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehemann"), 16920.00 EUR, 13536.00 EUR) { origin case_input; }
        assert "ehemann-werbungskosten-rente": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_sonstige(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehemann"), 0.00 EUR) { origin case_input; }
        assert "ehemann-gdb": schwerbehinderung(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehemann"), 80) { origin case_input; }
        assert "ehemann-pflege": pflegebeduerftig_mit_haeuslicher_pflege(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehemann")) { origin case_input; }
        assert "ehefrau-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:gdb80-pflege:haushalt"), entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehefrau")) { origin case_input; }
        assert "ehefrau-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehefrau"), KEIN_AUSLAENDER) { origin case_input; }
        assert "ehefrau-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehefrau"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "ehefrau-beziehung": beziehung(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehefrau"), entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehemann"), EHEGATTE_NICHT_DAUERND_GETRENNT) { origin case_input; }
        assert "ehefrau-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehefrau"), NEIN, JA, NEIN) { origin case_input; }
        assert "ehefrau-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehefrau")) { origin case_input; }
        assert "ehefrau-rente": de.tax.income_for_wohngeld::leibrente_gesetzliche_rentenversicherung(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehefrau"), 6480.00 EUR, 5184.00 EUR) { origin case_input; }
        assert "ehefrau-werbungskosten-rente": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_sonstige(entity_ref("urn:de:example:wohngeld:gdb80-pflege:ehefrau"), 0.00 EUR) { origin case_input; }
    }
    evaluate truth(monatliches_gesamteinkommen(entity_ref("urn:de:example:wohngeld:gdb80-pflege:haushalt"), 1589.70 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

