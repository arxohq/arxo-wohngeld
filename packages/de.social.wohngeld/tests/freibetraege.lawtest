        context { legal_time @2025-03-01; decision_time @2025-03-01T09:00:00Z; knowledge_time @2025-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:kind25:haushalt"), entity_ref("urn:de:example:wohngeld:kind25:vater"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:kind25:haushalt"), entity_ref("urn:de:example:wohngeld:kind25:vater"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:kind25:haushalt"), "Baden-Württemberg", "Friedrichshafen, Stadt") { origin case_input; }
