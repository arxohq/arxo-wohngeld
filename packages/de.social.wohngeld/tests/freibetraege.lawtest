        assert "kind-beziehung": beziehung(entity_ref("urn:de:example:wohngeld:kind25:kind"), entity_ref("urn:de:example:wohngeld:kind25:vater"), VERWANDT_ODER_VERSCHWAEGERT) { origin case_input; }
        assert "kind-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:kind25:kind"), NEIN, NEIN, NEIN) { origin case_input; }
        assert "kind-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:kind25:kind")) { origin case_input; }
        assert "kind-minijob": de.tax.income_for_wohngeld::arbeitsentgelt_40a_pauschal_besteuert(entity_ref("urn:de:example:wohngeld:kind25:kind"), 1800.00 EUR) { origin case_input; }
        assert "kind-minijob-aufwendungen": aufwendungen_pauschal_besteuertes_arbeitsentgelt(entity_ref("urn:de:example:wohngeld:kind25:kind"), 0.00 EUR) { origin case_input; }
        assert "kind-alter": alter_in_vollendeten_jahren(entity_ref("urn:de:example:wohngeld:kind25:kind"), 25) { origin case_input; }
        assert "kind-kind-von-vater": kind_von(entity_ref("urn:de:example:wohngeld:kind25:kind"), entity_ref("urn:de:example:wohngeld:kind25:vater")) { origin case_input; }
    }
    evaluate truth(abzug_13(entity_ref("urn:de:example:wohngeld:kind25:haushalt"), ERWERBSEINKOMMEN_KIND_17_NR4, entity_ref("urn:de:example:wohngeld:kind25:kind"), 1200 EUR));
