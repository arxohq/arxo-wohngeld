        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:mietverhaeltnis"), 385.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:haushalt")) { origin adjudicated; }
        assert "alleinstehender-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:alleinstehender")) { origin case_input; }
        assert "alleinstehender-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:alleinstehender"), KEIN_AUSLAENDER) { origin case_input; }
        assert "alleinstehender-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:alleinstehender"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "alleinstehender-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:alleinstehender"), NEIN, NEIN, NEIN) { origin case_input; }
        assert "alleinstehender-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:alleinstehender")) { origin case_input; }
        assert "alleinstehender-alg1": de.tax.income_for_wohngeld::arbeitslosengeld_sgb3(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:alleinstehender"), 9840.00 EUR) { origin case_input; }
    }
    evaluate truth(monatliches_gesamteinkommen(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:haushalt"), 820.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(hoechstbetrag_mit_klimakomponente(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:haushalt"), 510.20 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:bmwsb-2023-02:haushalt"), 263 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// PDF BMWSB «Rechenbeispiele» 2023 (17. Februar 2023), Rechenbeispiel 3 (фрагмент BMWSB_2023_BSP3). 
test "BMWSB 2023 Rechenbeispiel 3: Ehepaar mit Renten, Ehemann GdB 100, Leipzig (Mietenstufe II) — 336 EUR" {
    given {
        context { legal_time @2023-03-01; decision_time @2023-03-01T09:00:00Z; knowledge_time @2023-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehemann"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehemann"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:haushalt"), "Sachsen", "Leipzig, Stadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:mietverhaeltnis"), 480.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:haushalt")) { origin adjudicated; }
        assert "ehemann-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehemann")) { origin case_input; }
        assert "ehemann-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehemann"), KEIN_AUSLAENDER) { origin case_input; }
        assert "ehemann-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehemann"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "ehemann-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehemann"), NEIN, JA, NEIN) { origin case_input; }
        assert "ehemann-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehemann")) { origin case_input; }
        assert "ehemann-rente": de.tax.income_for_wohngeld::leibrente_gesetzliche_rentenversicherung(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehemann"), 10440.00 EUR, 8352.00 EUR) { origin case_input; }
        assert "ehemann-werbungskosten-rente": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_sonstige(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehemann"), 0.00 EUR) { origin case_input; }
        assert "ehemann-gdb": schwerbehinderung(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehemann"), 100) { origin case_input; }
        assert "ehefrau-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehefrau")) { origin case_input; }
        assert "ehefrau-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehefrau"), KEIN_AUSLAENDER) { origin case_input; }
        assert "ehefrau-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehefrau"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "ehefrau-beziehung": beziehung(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehefrau"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehemann"), EHEGATTE_NICHT_DAUERND_GETRENNT) { origin case_input; }
        assert "ehefrau-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehefrau"), NEIN, JA, NEIN) { origin case_input; }
        assert "ehefrau-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehefrau")) { origin case_input; }
        assert "ehefrau-rente": de.tax.income_for_wohngeld::leibrente_gesetzliche_rentenversicherung(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehefrau"), 6480.00 EUR, 5184.00 EUR) { origin case_input; }
        assert "ehefrau-werbungskosten-rente": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_sonstige(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:ehefrau"), 0.00 EUR) { origin case_input; }
    }
    evaluate truth(monatliches_gesamteinkommen(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:haushalt"), 1103.70 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(hoechstbetrag_mit_klimakomponente(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:haushalt"), 498.80 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:bmwsb-2023-03:haushalt"), 336 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// PDF BMWSB «Rechenbeispiele» 2023 (17. Februar 2023), Rechenbeispiel 5 (фрагмент BMWSB_2023_BSP5). Unterhaltsvorschuss 474,00 в PDF общей суммой; делу разнесено поровну.
test "BMWSB 2023 Rechenbeispiel 5: Alleinerziehende mit zwei Kindern, Wiesbaden (Mietenstufe VI) — 428 EUR" {
    given {
        context { legal_time @2023-03-01; decision_time @2023-03-01T09:00:00Z; knowledge_time @2023-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mutter"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mutter"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:haushalt"), "Hessen", "Wiesbaden, Landeshaupstadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mietverhaeltnis"), 650.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:haushalt")) { origin adjudicated; }
        assert "mutter-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mutter")) { origin case_input; }
        assert "mutter-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mutter"), KEIN_AUSLAENDER) { origin case_input; }
        assert "mutter-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mutter"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "mutter-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mutter"), NEIN, JA, JA) { origin case_input; }
        assert "mutter-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mutter")) { origin case_input; }
        assert "mutter-lohn": de.tax.income_for_wohngeld::arbeitslohn_in_geld(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mutter"), 17520.00 EUR) { origin case_input; }
        assert "mutter-werbungskosten": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_arbeit(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mutter"), 0.00 EUR) { origin case_input; }
        assert "kind9-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:kind9")) { origin case_input; }
        assert "kind9-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:kind9"), KEIN_AUSLAENDER) { origin case_input; }
        assert "kind9-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:kind9"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "kind9-beziehung": beziehung(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:kind9"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mutter"), VERWANDT_ODER_VERSCHWAEGERT) { origin case_input; }
