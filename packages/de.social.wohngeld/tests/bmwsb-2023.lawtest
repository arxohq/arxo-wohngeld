// PDF BMWSB «Rechenbeispiele» 2023 (17. Februar 2023), Rechenbeispiel 10 (фрагмент BMWSB_2023_BSP10). PDF 2023: «Höchstbetrag (50% von 619,80 Euro) 309,90 Euro (plus Klimakomponente)» — 595 + 24,80.
test "BMWSB 2023 Rechenbeispiel 10: Vater Rentner, Sohn vom Wohngeld ausgeschlossen, Lübeck (Mietenstufe IV) — 181 EUR" {
    given {
        context { legal_time @2023-03-01; decision_time @2023-03-01T09:00:00Z; knowledge_time @2023-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:vater"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:vater"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt"), "Schleswig-Holstein", "Lübeck, Stadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:mietverhaeltnis"), 570.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt")) { origin adjudicated; }
        assert "vater-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:vater")) { origin case_input; }
        assert "vater-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:vater"), KEIN_AUSLAENDER) { origin case_input; }
        assert "vater-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:vater"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "vater-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:vater"), NEIN, JA, NEIN) { origin case_input; }
        assert "vater-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:vater")) { origin case_input; }
        assert "vater-rente": de.tax.income_for_wohngeld::leibrente_gesetzliche_rentenversicherung(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:vater"), 10560.00 EUR, 8448.00 EUR) { origin case_input; }
        assert "vater-werbungskosten-rente": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_sonstige(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:vater"), 0.00 EUR) { origin case_input; }
        assert "sohn-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:sohn")) { origin case_input; }
        assert "sohn-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:sohn"), KEIN_AUSLAENDER) { origin case_input; }
        assert "sohn-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:sohn"), NR1_GRUNDSICHERUNGSGELD_SGB2, JA, NEIN, NEIN, NEIN) { origin case_input; }
        assert "sohn-beziehung": beziehung(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:sohn"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:vater"), VERWANDT_ODER_VERSCHWAEGERT) { origin case_input; }
    }
    evaluate truth(monatliches_gesamteinkommen(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt"), 784.35 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(zu_beruecksichtigende_miete(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt"), 356.30 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(hoechstbetrag_mit_klimakomponente(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt"), 619.80 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:bmwsb-2023-10:haushalt"), 181 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
