language "law.core" version "0.2";
package de.social.wohngeld version "0.1.0";
namespace "urn:de:social:clir:wohngeld";

// Официальные примеры BMWSB 2023 года: 9 арендных из 10 (№ 4 — Lastenzuschuss).
// Ожидания — числа PDF; допущения дела названы в комментарии к сценарию.

// PDF BMWSB «Rechenbeispiele» 2023 (17. Februar 2023), Rechenbeispiel 1 (фрагмент BMWSB_2023_BSP1). Строка «Zu berücksichtigende Miete» PDF 2023 года показана без Heizkostenentlastung, но итог
// примера её включает (570 € в № 7 получается только с 197,80 €); ожидание — итог Wohngeld.
test "BMWSB 2023 Rechenbeispiel 1: alleinstehende Rentnerin, Jüterbog (Mietenstufe I) — 250 EUR" {
    given {
        context { legal_time @2023-03-01; decision_time @2023-03-01T09:00:00Z; knowledge_time @2023-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:rentnerin"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:rentnerin"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:haushalt"), "Brandenburg", "Jüterbog, Stadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:mietverhaeltnis"), 335.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:haushalt")) { origin adjudicated; }
        assert "rentnerin-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:haushalt"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:rentnerin")) { origin case_input; }
        assert "rentnerin-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:rentnerin"), KEIN_AUSLAENDER) { origin case_input; }
        assert "rentnerin-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:rentnerin"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "rentnerin-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:rentnerin"), NEIN, JA, NEIN) { origin case_input; }
        assert "rentnerin-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:rentnerin")) { origin case_input; }
        assert "rentnerin-rente": de.tax.income_for_wohngeld::leibrente_gesetzliche_rentenversicherung(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:rentnerin"), 10320.00 EUR, 8256.00 EUR) { origin case_input; }
        assert "rentnerin-werbungskosten-rente": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_sonstige(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:rentnerin"), 0.00 EUR) { origin case_input; }
    }
    evaluate truth(monatliches_gesamteinkommen(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:haushalt"), 766.35 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(hoechstbetrag_mit_klimakomponente(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:haushalt"), 366.20 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:bmwsb-2023-01:haushalt"), 250 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// PDF BMWSB «Rechenbeispiele» 2023 (17. Februar 2023), Rechenbeispiel 2 (фрагмент BMWSB_2023_BSP2). 
test "BMWSB 2023 Rechenbeispiel 2: Alleinstehender mit ALG I, Ludwigshafen am Rhein (Mietenstufe IV) — 263 EUR" {
    given {
        context { legal_time @2023-03-01; decision_time @2023-03-01T09:00:00Z; knowledge_time @2023-03-01T09:00:00Z; timezone "Europe/Berlin"; }
