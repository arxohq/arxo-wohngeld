        assert "kind13-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:kind13"), KEIN_AUSLAENDER) { origin case_input; }
        assert "kind13-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:kind13"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "kind13-beziehung": beziehung(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:kind13"), entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:mutter"), VERWANDT_ODER_VERSCHWAEGERT) { origin case_input; }
        assert "kind13-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:bmwsb-2023-05:kind13"), NEIN, NEIN, NEIN) { origin case_input; }
