language "law.core" version "0.2";
package de.social.wohngeld version "0.1.0";
namespace "urn:de:social:clir:wohngeld";

// Ответы калькулятора BMWSB 2025 как независимые ожидания и одно квалифицированное расхождение.

// Ожидание — ответ закреплённого калькулятора (sources/bmwsb/wohngeldrechner-2025.module.js), дело `r01-single-I`
// в tools/rechner-2025-cases.json. Поля калькулятора: доход и Werbungskosten в месяц, флажки § 16, Mietenstufe.
test "Wohngeldrechner BMWSB 2025, Fall r01-single-I: 139 EUR" {
    given {
        context { legal_time @2025-03-01; decision_time @2025-03-01T09:00:00Z; knowledge_time @2025-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:r01:haushalt"), entity_ref("urn:de:example:wohngeld:r01:person"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:r01:haushalt"), entity_ref("urn:de:example:wohngeld:r01:person"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:r01:haushalt"), "Brandenburg", "Jüterbog, Stadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:r01:haushalt"), entity_ref("urn:de:example:wohngeld:r01:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:r01:mietverhaeltnis"), 300.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:r01:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:r01:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:r01:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:r01:haushalt")) { origin adjudicated; }
        assert "person-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:r01:haushalt"), entity_ref("urn:de:example:wohngeld:r01:person")) { origin case_input; }
        assert "person-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:r01:person"), KEIN_AUSLAENDER) { origin case_input; }
        assert "person-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:r01:person"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "person-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:r01:person"), NEIN, JA, JA) { origin case_input; }
        assert "person-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:r01:person")) { origin case_input; }
        assert "person-lohn": de.tax.income_for_wohngeld::arbeitslohn_in_geld(entity_ref("urn:de:example:wohngeld:r01:person"), 16800.00 EUR) { origin case_input; }
        assert "person-werbungskosten": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_arbeit(entity_ref("urn:de:example:wohngeld:r01:person"), 0.00 EUR) { origin case_input; }
    }
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:r01:haushalt"), 139 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

