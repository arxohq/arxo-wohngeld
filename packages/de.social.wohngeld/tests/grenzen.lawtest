// Пара с «9 EUR»: зарплата 1 925,34 и 1 925,35 € в месяц, один человек, Weimar (III), Miete 400.
// Ожидания z4 — независимая арифметика `tools/reference_calc.py` по Anlagen 2, 3 (2. WoGFV).
test "Grenze § 21 Nr. 1: Wohngeld 10 EUR (z4 = 9,5034872592) — Anspruch besteht" {
    given {
        context { legal_time @2025-03-01; decision_time @2025-03-01T09:00:00Z; knowledge_time @2025-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:schwelle-10:haushalt"), entity_ref("urn:de:example:wohngeld:schwelle-10:person"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:schwelle-10:haushalt"), entity_ref("urn:de:example:wohngeld:schwelle-10:person"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:schwelle-10:haushalt"), "Thüringen", "Weimar, Stadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:schwelle-10:haushalt"), entity_ref("urn:de:example:wohngeld:schwelle-10:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:schwelle-10:mietverhaeltnis"), 400.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:schwelle-10:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:schwelle-10:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:schwelle-10:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:schwelle-10:haushalt")) { origin adjudicated; }
        assert "person-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:schwelle-10:haushalt"), entity_ref("urn:de:example:wohngeld:schwelle-10:person")) { origin case_input; }
        assert "person-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:schwelle-10:person"), KEIN_AUSLAENDER) { origin case_input; }
        assert "person-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:schwelle-10:person"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "person-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:schwelle-10:person"), NEIN, JA, JA) { origin case_input; }
        assert "person-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:schwelle-10:person")) { origin case_input; }
        assert "person-lohn": de.tax.income_for_wohngeld::arbeitslohn_in_geld(entity_ref("urn:de:example:wohngeld:schwelle-10:person"), 23104.08 EUR) { origin case_input; }
        assert "person-werbungskosten": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_arbeit(entity_ref("urn:de:example:wohngeld:schwelle-10:person"), 0.00 EUR) { origin case_input; }
    }
    evaluate truth(wohngeld_ungerundet(entity_ref("urn:de:example:wohngeld:schwelle-10:haushalt"), 9.5034872592));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:schwelle-10:haushalt"), 10 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeldanspruch(entity_ref("urn:de:example:wohngeld:schwelle-10:haushalt"), 10 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(kein_wohngeldanspruch(entity_ref("urn:de:example:wohngeld:schwelle-10:haushalt"), WENIGER_ALS_10_EURO_21_NR1));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

