        assert "person-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:dreizehn-2025-03-01:person"), KEIN_AUSLAENDER) { origin case_input; }
        assert "person-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:dreizehn-2025-03-01:person"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
