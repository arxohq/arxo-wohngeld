test "Anlage WoGV, Vorbemerkung: nicht gesondert aufgeführte Gemeinde Tarp erhält die Mietenstufe des Kreises Schleswig-Flensburg (I)" {
    given {
        context { legal_time @2025-03-01; decision_time @2025-03-01T09:00:00Z; knowledge_time @2025-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:kreis:haushalt"), entity_ref("urn:de:example:wohngeld:kreis:person"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:kreis:haushalt"), entity_ref("urn:de:example:wohngeld:kreis:person"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:kreis:haushalt"), "Schleswig-Holstein", "Tarp") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:kreis:haushalt"), entity_ref("urn:de:example:wohngeld:kreis:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:kreis:mietverhaeltnis"), 500.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:kreis:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "kreis": wohnort_kreis(entity_ref("urn:de:example:wohngeld:kreis:haushalt"), "Schleswig-Flensburg") { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:kreis:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:kreis:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:kreis:haushalt")) { origin adjudicated; }
        assert "person-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:kreis:haushalt"), entity_ref("urn:de:example:wohngeld:kreis:person")) { origin case_input; }
        assert "person-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:kreis:person"), KEIN_AUSLAENDER) { origin case_input; }
        assert "person-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:kreis:person"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "person-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:kreis:person"), NEIN, JA, JA) { origin case_input; }
        assert "person-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:kreis:person")) { origin case_input; }
        assert "person-lohn": de.tax.income_for_wohngeld::arbeitslohn_in_geld(entity_ref("urn:de:example:wohngeld:kreis:person"), 24000.00 EUR) { origin case_input; }
        assert "person-werbungskosten": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_arbeit(entity_ref("urn:de:example:wohngeld:kreis:person"), 0.00 EUR) { origin case_input; }
    }
    evaluate truth(mietenstufe(entity_ref("urn:de:example:wohngeld:kreis:haushalt"), MIETENSTUFE_I));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Kreisangabe в деле неверна намеренно: для перечисленной Gemeinde подстановка Kreis не применяется.
