language "law.core" version "0.2";
package de.social.wohngeld version "0.1.0";
namespace "urn:de:social:clir:wohngeld";

// Пары границ: потолок Miete, порог 10 €, округление до евро, минимумы M и Y,
// число членов сверх двенадцати, Kreis и острова.

// § 11 Abs. 1 S. 1 Nr. 1: «jedoch nur bis zur Höhe der Summe» aus Höchstbetrag (Anlage 1: 1 Mitglied, III — 456)
// und Klimakomponente (§ 12 Abs. 7: 19,20); плюс Heizkostenentlastung 110,40. Ожидание — арифметика текста.
test "Grenze Höchstbetrag: Miete 475.19 EUR bei Höchstbetrag 456 + Klimakomponente 19,20 (на 1 цент ниже потолка — Miete целиком)" {
    given {
        context { legal_time @2025-03-01; decision_time @2025-03-01T09:00:00Z; knowledge_time @2025-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:hb-475.19:haushalt"), entity_ref("urn:de:example:wohngeld:hb-475.19:person"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:hb-475.19:haushalt"), entity_ref("urn:de:example:wohngeld:hb-475.19:person"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:hb-475.19:haushalt"), "Thüringen", "Weimar, Stadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:hb-475.19:haushalt"), entity_ref("urn:de:example:wohngeld:hb-475.19:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:hb-475.19:mietverhaeltnis"), 475.19 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:hb-475.19:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:hb-475.19:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:hb-475.19:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:hb-475.19:haushalt")) { origin adjudicated; }
        assert "person-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:hb-475.19:haushalt"), entity_ref("urn:de:example:wohngeld:hb-475.19:person")) { origin case_input; }
        assert "person-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:hb-475.19:person"), KEIN_AUSLAENDER) { origin case_input; }
        assert "person-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:hb-475.19:person"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "person-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:hb-475.19:person"), NEIN, JA, JA) { origin case_input; }
        assert "person-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:hb-475.19:person")) { origin case_input; }
        assert "person-lohn": de.tax.income_for_wohngeld::arbeitslohn_in_geld(entity_ref("urn:de:example:wohngeld:hb-475.19:person"), 18000.00 EUR) { origin case_input; }
        assert "person-werbungskosten": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_arbeit(entity_ref("urn:de:example:wohngeld:hb-475.19:person"), 0.00 EUR) { origin case_input; }
    }
    evaluate truth(zu_beruecksichtigende_miete(entity_ref("urn:de:example:wohngeld:hb-475.19:haushalt"), 585.59 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

