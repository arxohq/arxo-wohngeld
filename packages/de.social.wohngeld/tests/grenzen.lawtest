        assert "person-lohn": de.tax.income_for_wohngeld::arbeitslohn_in_geld(entity_ref("urn:de:example:wohngeld:dreizehn-2025-03-01:person"), 36000.00 EUR) { origin case_input; }
        assert "person-werbungskosten": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_arbeit(entity_ref("urn:de:example:wohngeld:dreizehn-2025-03-01:person"), 0.00 EUR) { origin case_input; }
        assert "k1-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:dreizehn-2025-03-01:haushalt"), entity_ref("urn:de:example:wohngeld:dreizehn-2025-03-01:k1")) { origin case_input; }
