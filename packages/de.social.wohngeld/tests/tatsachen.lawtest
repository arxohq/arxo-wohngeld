language "law.core" version "0.2";
package de.social.wohngeld version "0.1.0";
namespace "urn:de:social:clir:wohngeld";

// Недостаточные и противоречивые факты.

// Доход считается, сумма — нет: без Mietenstufe нет Höchstbetrag.
test "unzureichende Tatsachen: ohne Wohnort keine Mietenstufe und kein Wohngeld (nicht 0)" {
    given {
        context { legal_time @2025-03-01; decision_time @2025-03-01T09:00:00Z; knowledge_time @2025-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:ohne-wohnort:haushalt"), entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehefrau"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:ohne-wohnort:haushalt"), entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehefrau"), MIETVERHAELTNIS) { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:ohne-wohnort:haushalt"), entity_ref("urn:de:example:wohngeld:ohne-wohnort:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:ohne-wohnort:mietverhaeltnis"), 580.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:ohne-wohnort:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:ohne-wohnort:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:ohne-wohnort:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:ohne-wohnort:haushalt")) { origin adjudicated; }
        assert "ehefrau-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:ohne-wohnort:haushalt"), entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehefrau")) { origin case_input; }
        assert "ehefrau-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehefrau"), KEIN_AUSLAENDER) { origin case_input; }
        assert "ehefrau-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehefrau"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "ehefrau-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehefrau"), NEIN, JA, JA) { origin case_input; }
        assert "ehefrau-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehefrau")) { origin case_input; }
        assert "ehefrau-lohn": de.tax.income_for_wohngeld::arbeitslohn_in_geld(entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehefrau"), 26880.00 EUR) { origin case_input; }
        assert "ehefrau-werbungskosten": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_arbeit(entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehefrau"), 0.00 EUR) { origin case_input; }
        assert "ehemann-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:ohne-wohnort:haushalt"), entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehemann")) { origin case_input; }
        assert "ehemann-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehemann"), KEIN_AUSLAENDER) { origin case_input; }
        assert "ehemann-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehemann"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "ehemann-beziehung": beziehung(entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehemann"), entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehefrau"), EHEGATTE_NICHT_DAUERND_GETRENNT) { origin case_input; }
        assert "ehemann-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehemann"), NEIN, NEIN, NEIN) { origin case_input; }
        assert "ehemann-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:ohne-wohnort:ehemann")) { origin case_input; }
    }
    evaluate truth(monatliches_gesamteinkommen(entity_ref("urn:de:example:wohngeld:ohne-wohnort:haushalt"), 1710.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:ohne-wohnort:haushalt"), 0 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

