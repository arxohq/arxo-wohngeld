language "law.core" version "0.2";
package de.social.wohngeld version "0.1.0";
namespace "urn:de:social:clir:wohngeld";

// Исключения §§ 7, 8, 20, 21 и каналы суждения § 5 Abs. 1 S. 2 Nr. 3, § 21 Nr. 3.

// Исключение установлено фактом решения другого органа (трансфер с Kosten der Unterkunft), а не выводом из молчания.
test "§ 7 Abs. 1 Nr. 1, § 21 Nr. 2: alleinstehender Empfänger von Grundsicherungsgeld mit Kosten der Unterkunft — kein Anspruch" {
    given {
        context { legal_time @2025-03-01; decision_time @2025-03-01T09:00:00Z; knowledge_time @2025-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:allein-buergergeld:haushalt"), entity_ref("urn:de:example:wohngeld:allein-buergergeld:person"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:allein-buergergeld:haushalt"), entity_ref("urn:de:example:wohngeld:allein-buergergeld:person"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:allein-buergergeld:haushalt"), "Thüringen", "Weimar, Stadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:allein-buergergeld:haushalt"), entity_ref("urn:de:example:wohngeld:allein-buergergeld:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:allein-buergergeld:mietverhaeltnis"), 500.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:allein-buergergeld:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:allein-buergergeld:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:allein-buergergeld:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:allein-buergergeld:haushalt")) { origin adjudicated; }
        assert "person-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:allein-buergergeld:haushalt"), entity_ref("urn:de:example:wohngeld:allein-buergergeld:person")) { origin case_input; }
        assert "person-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:allein-buergergeld:person"), KEIN_AUSLAENDER) { origin case_input; }
        assert "person-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:allein-buergergeld:person"), NR1_GRUNDSICHERUNGSGELD_SGB2, JA, NEIN, NEIN, NEIN) { origin case_input; }
    }
    evaluate truth(vom_wohngeld_ausgeschlossen(entity_ref("urn:de:example:wohngeld:allein-buergergeld:person")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(kein_wohngeldanspruch(entity_ref("urn:de:example:wohngeld:allein-buergergeld:haushalt"), ALLE_AUSGESCHLOSSEN_21_NR2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeldberechtigt(entity_ref("urn:de:example:wohngeld:allein-buergergeld:haushalt"), entity_ref("urn:de:example:wohngeld:allein-buergergeld:person")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "§ 7 Abs. 1 S. 3 Nr. 1: Leistung ausschließlich als Darlehen — kein Ausschluss" {
    given {
        context { legal_time @2025-03-01; decision_time @2025-03-01T09:00:00Z; knowledge_time @2025-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:darlehen:haushalt"), entity_ref("urn:de:example:wohngeld:darlehen:person"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:darlehen:haushalt"), entity_ref("urn:de:example:wohngeld:darlehen:person"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:darlehen:haushalt"), "Thüringen", "Weimar, Stadt") { origin case_input; }
