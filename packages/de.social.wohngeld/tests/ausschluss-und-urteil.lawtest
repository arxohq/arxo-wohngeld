        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:missbrauch-offen:haushalt"), entity_ref("urn:de:example:wohngeld:missbrauch-offen:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:missbrauch-offen:mietverhaeltnis"), 500.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:missbrauch-offen:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:missbrauch-offen:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:missbrauch-offen:haushalt")) { origin case_input; }
        assert "person-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:missbrauch-offen:haushalt"), entity_ref("urn:de:example:wohngeld:missbrauch-offen:person")) { origin case_input; }
        assert "person-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:missbrauch-offen:person"), KEIN_AUSLAENDER) { origin case_input; }
        assert "person-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:missbrauch-offen:person"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "person-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:missbrauch-offen:person"), NEIN, JA, JA) { origin case_input; }
        assert "person-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:missbrauch-offen:person")) { origin case_input; }
        assert "person-lohn": de.tax.income_for_wohngeld::arbeitslohn_in_geld(entity_ref("urn:de:example:wohngeld:missbrauch-offen:person"), 18000.00 EUR) { origin case_input; }
        assert "person-werbungskosten": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_arbeit(entity_ref("urn:de:example:wohngeld:missbrauch-offen:person"), 0.00 EUR) { origin case_input; }
    }
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:missbrauch-offen:haushalt"), 202 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeldanspruch(entity_ref("urn:de:example:wohngeld:missbrauch-offen:haushalt"), 202 EUR));
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(missbraeuchliche_inanspruchnahme, Wohngeldbehoerde);
}

