// Состав BMWSB 2025 № 10, но заявитель — исключённый сын: сумма та же (191 €), учитывается один член.
test "§ 3 Abs. 4: ausgeschlossener Antragsteller bleibt wohngeldberechtigt, wenn er mit einem zu berücksichtigenden Mitglied wohnt" {
    given {
        context { legal_time @2025-03-01; decision_time @2025-03-01T09:00:00Z; knowledge_time @2025-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:drei-vier:haushalt"), entity_ref("urn:de:example:wohngeld:drei-vier:sohn"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:drei-vier:haushalt"), entity_ref("urn:de:example:wohngeld:drei-vier:sohn"), MIETVERHAELTNIS) { origin case_input; }
        assert "fact-wohnort": wohnort(entity_ref("urn:de:example:wohngeld:drei-vier:haushalt"), "Schleswig-Holstein", "Lübeck, Stadt") { origin case_input; }
        assert "mv": mietverhaeltnis_des_haushalts(entity_ref("urn:de:example:wohngeld:drei-vier:haushalt"), entity_ref("urn:de:example:wohngeld:drei-vier:mietverhaeltnis")) { origin case_input; }
        assert "entgelt": vereinbartes_entgelt(entity_ref("urn:de:example:wohngeld:drei-vier:mietverhaeltnis"), 570.00 EUR) { origin case_input; }
        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:drei-vier:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:drei-vier:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:drei-vier:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:drei-vier:haushalt")) { origin adjudicated; }
        assert "sohn-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:drei-vier:haushalt"), entity_ref("urn:de:example:wohngeld:drei-vier:sohn")) { origin case_input; }
        assert "sohn-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:drei-vier:sohn"), KEIN_AUSLAENDER) { origin case_input; }
        assert "sohn-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:drei-vier:sohn"), NR1_GRUNDSICHERUNGSGELD_SGB2, JA, NEIN, NEIN, NEIN) { origin case_input; }
        assert "vater-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:drei-vier:haushalt"), entity_ref("urn:de:example:wohngeld:drei-vier:vater")) { origin case_input; }
        assert "vater-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:drei-vier:vater"), KEIN_AUSLAENDER) { origin case_input; }
        assert "vater-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:drei-vier:vater"), KEINE, NEIN, NEIN, NEIN, NEIN) { origin case_input; }
        assert "vater-beziehung": beziehung(entity_ref("urn:de:example:wohngeld:drei-vier:vater"), entity_ref("urn:de:example:wohngeld:drei-vier:sohn"), VERWANDT_ODER_VERSCHWAEGERT) { origin case_input; }
        assert "vater-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:drei-vier:vater"), NEIN, JA, NEIN) { origin case_input; }
        assert "vater-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:drei-vier:vater")) { origin case_input; }
        assert "vater-rente": de.tax.income_for_wohngeld::leibrente_gesetzliche_rentenversicherung(entity_ref("urn:de:example:wohngeld:drei-vier:vater"), 10560.00 EUR, 8448.00 EUR) { origin case_input; }
        assert "vater-werbungskosten-rente": de.tax.income_for_wohngeld::nachgewiesene_werbungskosten_sonstige(entity_ref("urn:de:example:wohngeld:drei-vier:vater"), 0.00 EUR) { origin case_input; }
    }
    evaluate truth(wohngeldberechtigt(entity_ref("urn:de:example:wohngeld:drei-vier:haushalt"), entity_ref("urn:de:example:wohngeld:drei-vier:sohn")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wohngeld_monatlich(entity_ref("urn:de:example:wohngeld:drei-vier:haushalt"), 191 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

