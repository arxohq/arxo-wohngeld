    expect evaluation_status == COMPUTED;
}

// «soweit die Inanspruchnahme missbräuchlich wäre, insbesondere wegen erheblichen Vermögens» — оценка органа, числа в законе нет.
// Сумма 202 € — `tools/reference_calc.py` (один человек, Weimar III, зарплата 1 500 €, −20 %, Miete 500; z4 = 202,1965960960).
test "§ 21 Nr. 3 ohne Würdigung der Wohngeldbehörde: Betrag berechnet, Anspruch verlangt Urteil (REQUIRES_JUDGMENT)" {
    given {
        context { legal_time @2025-03-01; decision_time @2025-03-01T09:00:00Z; knowledge_time @2025-03-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "antrag": wohngeldantrag(entity_ref("urn:de:example:wohngeld:missbrauch-offen:haushalt"), entity_ref("urn:de:example:wohngeld:missbrauch-offen:person"), MIETZUSCHUSS) { origin case_input; }
        assert "grundlage": nutzungsgrundlage(entity_ref("urn:de:example:wohngeld:missbrauch-offen:haushalt"), entity_ref("urn:de:example:wohngeld:missbrauch-offen:person"), MIETVERHAELTNIS) { origin case_input; }
