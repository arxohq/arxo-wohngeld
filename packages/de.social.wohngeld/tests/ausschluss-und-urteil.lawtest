        assert "bafoeg": ausbildungsfoerderung_20_abs2(entity_ref("urn:de:example:wohngeld:darlehen:haushalt"), NEIN, NEIN) { origin case_input; }
        assert "miete-vollstaendig": angaben_zur_miete_vollstaendig(entity_ref("urn:de:example:wohngeld:darlehen:mietverhaeltnis")) { origin case_input; }
        assert "freibetraege-vollstaendig": angaben_freibetraege_vollstaendig(entity_ref("urn:de:example:wohngeld:darlehen:haushalt")) { origin case_input; }
        assert "behoerde-21-nr3": not missbraeuchliche_inanspruchnahme(entity_ref("urn:de:example:wohngeld:darlehen:haushalt")) { origin adjudicated; }
        assert "person-lebensmittelpunkt": lebensmittelpunkt_im_wohnraum(entity_ref("urn:de:example:wohngeld:darlehen:haushalt"), entity_ref("urn:de:example:wohngeld:darlehen:person")) { origin case_input; }
        assert "person-aufenthalt": aufenthaltsrechtlicher_status(entity_ref("urn:de:example:wohngeld:darlehen:person"), KEIN_AUSLAENDER) { origin case_input; }
        assert "person-leistung7": leistungsbezug_7(entity_ref("urn:de:example:wohngeld:darlehen:person"), NR1_GRUNDSICHERUNGSGELD_SGB2, JA, JA, NEIN, NEIN) { origin case_input; }
        assert "person-abzug16": abzugsmerkmale_16(entity_ref("urn:de:example:wohngeld:darlehen:person"), NEIN, NEIN, NEIN) { origin case_input; }
        assert "person-einkommen-vollstaendig": einkommensangaben_vollstaendig(entity_ref("urn:de:example:wohngeld:darlehen:person")) { origin case_input; }
        assert "person-alg1": de.tax.income_for_wohngeld::arbeitslosengeld_sgb3(entity_ref("urn:de:example:wohngeld:darlehen:person"), 10800.00 EUR) { origin case_input; }
    }
    evaluate truth(nicht_vom_wohngeld_ausgeschlossen(entity_ref("urn:de:example:wohngeld:darlehen:person")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(vom_wohngeld_ausgeschlossen(entity_ref("urn:de:example:wohngeld:darlehen:person")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

