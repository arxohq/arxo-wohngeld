// --- Anlage 1, § 12 Abs. 6, 7: суммы по числу членов --------------------------
//
// Ветви параметров стоят внутри `match`/`if`, а не в `let`: жадная привязка
// потребовала бы покрытия невыбранных параметров (замер fr.apl, 14.09.2026).

function hoechstbetrag_bis_fuenf(n: Integer, s: Mietenstufe) -> Money =
    if n == 1 then (match s {
        MIETENSTUFE_I => HoechstbetragMitglieder1MietenstufeI;
        MIETENSTUFE_II => HoechstbetragMitglieder1MietenstufeII;
        MIETENSTUFE_III => HoechstbetragMitglieder1MietenstufeIII;
        MIETENSTUFE_IV => HoechstbetragMitglieder1MietenstufeIV;
        MIETENSTUFE_V => HoechstbetragMitglieder1MietenstufeV;
        MIETENSTUFE_VI => HoechstbetragMitglieder1MietenstufeVI;
        MIETENSTUFE_VII => HoechstbetragMitglieder1MietenstufeVII;
    }) else if n == 2 then (match s {
        MIETENSTUFE_I => HoechstbetragMitglieder2MietenstufeI;
        MIETENSTUFE_II => HoechstbetragMitglieder2MietenstufeII;
        MIETENSTUFE_III => HoechstbetragMitglieder2MietenstufeIII;
        MIETENSTUFE_IV => HoechstbetragMitglieder2MietenstufeIV;
        MIETENSTUFE_V => HoechstbetragMitglieder2MietenstufeV;
        MIETENSTUFE_VI => HoechstbetragMitglieder2MietenstufeVI;
        MIETENSTUFE_VII => HoechstbetragMitglieder2MietenstufeVII;
    }) else if n == 3 then (match s {
        MIETENSTUFE_I => HoechstbetragMitglieder3MietenstufeI;
        MIETENSTUFE_II => HoechstbetragMitglieder3MietenstufeII;
        MIETENSTUFE_III => HoechstbetragMitglieder3MietenstufeIII;
        MIETENSTUFE_IV => HoechstbetragMitglieder3MietenstufeIV;
        MIETENSTUFE_V => HoechstbetragMitglieder3MietenstufeV;
        MIETENSTUFE_VI => HoechstbetragMitglieder3MietenstufeVI;
        MIETENSTUFE_VII => HoechstbetragMitglieder3MietenstufeVII;
    }) else if n == 4 then (match s {
        MIETENSTUFE_I => HoechstbetragMitglieder4MietenstufeI;
        MIETENSTUFE_II => HoechstbetragMitglieder4MietenstufeII;
        MIETENSTUFE_III => HoechstbetragMitglieder4MietenstufeIII;
        MIETENSTUFE_IV => HoechstbetragMitglieder4MietenstufeIV;
        MIETENSTUFE_V => HoechstbetragMitglieder4MietenstufeV;
        MIETENSTUFE_VI => HoechstbetragMitglieder4MietenstufeVI;
        MIETENSTUFE_VII => HoechstbetragMitglieder4MietenstufeVII;
    }) else (match s {
        MIETENSTUFE_I => HoechstbetragMitglieder5MietenstufeI;
        MIETENSTUFE_II => HoechstbetragMitglieder5MietenstufeII;
        MIETENSTUFE_III => HoechstbetragMitglieder5MietenstufeIII;
        MIETENSTUFE_IV => HoechstbetragMitglieder5MietenstufeIV;
        MIETENSTUFE_V => HoechstbetragMitglieder5MietenstufeV;
        MIETENSTUFE_VI => HoechstbetragMitglieder5MietenstufeVI;
        MIETENSTUFE_VII => HoechstbetragMitglieder5MietenstufeVII;
    });

function hoechstbetrag_mehrbetrag(s: Mietenstufe) -> Money = match s {
        MIETENSTUFE_I => HoechstbetragMehrbetragMietenstufeI;
        MIETENSTUFE_II => HoechstbetragMehrbetragMietenstufeII;
        MIETENSTUFE_III => HoechstbetragMehrbetragMietenstufeIII;
        MIETENSTUFE_IV => HoechstbetragMehrbetragMietenstufeIV;
        MIETENSTUFE_V => HoechstbetragMehrbetragMietenstufeV;
        MIETENSTUFE_VI => HoechstbetragMehrbetragMietenstufeVI;
        MIETENSTUFE_VII => HoechstbetragMehrbetragMietenstufeVII;
};

function hoechstbetrag(n: Integer, s: Mietenstufe) -> Money =
    if n <= 5 then hoechstbetrag_bis_fuenf(n, s)
    else hoechstbetrag_bis_fuenf(5, s) + hoechstbetrag_mehrbetrag(s) * (n - 5);

function heizkostenentlastung_betrag(n: Integer) -> Money =
    if n == 1 then HeizkostenentlastungMitglieder1
    else if n == 2 then HeizkostenentlastungMitglieder2
    else if n == 3 then HeizkostenentlastungMitglieder3
    else if n == 4 then HeizkostenentlastungMitglieder4
    else HeizkostenentlastungMitglieder5 + HeizkostenentlastungMehrbetrag * (n - 5);

function klimakomponente_betrag(n: Integer) -> Money =
    if n == 1 then KlimakomponenteMitglieder1
    else if n == 2 then KlimakomponenteMitglieder2
    else if n == 3 then KlimakomponenteMitglieder3
    else if n == 4 then KlimakomponenteMitglieder4
    else KlimakomponenteMitglieder5 + KlimakomponenteMehrbetrag * (n - 5);

// § 11 Abs. 3: доля по отношению n / N, 10 знаков по Anlage 3 Nr. 2.
function anteil(betrag: Money, n: Integer, gesamt: Integer) -> Money =
    if n == gesamt then betrag else div_round(betrag * n, 1.0 * gesamt, 10, "HALF_UP");

// --- § 9: Miete -------------------------------------------------------------

// СУММЫ БЕЗ ПУСТОГО АГРЕГАТА. Пустая сумма §59 — отказ, а не ноль; поэтому каждая
// группа вычетов получает НУЛЕВУЮ позицию только из объявления о полноте сведений
// (`angaben_zur_miete_vollstaendig`). Нулевая позиция юридически верна сама по себе:
// «прочие Betriebskosten не исключаются — 0 €», «иных выплат третьим — 0 €».

relation umlage_abzug(mv: de.social.wohngeld_verordnung::Mietverhaeltnis, position: de.social.wohngeld_verordnung::BetriebskostenPosition, betrag: Money) kind institutional {
    label de official "nach § 9 Absatz 2 Nummer 1 und 2 außer Betracht bleibende Umlage (§ 6 Absatz 1 WoGV)";
    label en unofficial "disregarded operating-cost charge";
}

relation kosten_abzug(mv: de.social.wohngeld_verordnung::Mietverhaeltnis, art: de.social.wohngeld_verordnung::KostenartNeunZwei, betrag: Money) kind institutional {
    label de official "ausgewiesene Kosten oder Vergütungen, die nach § 9 Absatz 2 außer Betracht bleiben";
    label en unofficial "shown costs disregarded under sec. 9(2)";
}

relation pauschbetrag_abzug(mv: de.social.wohngeld_verordnung::Mietverhaeltnis, art: de.social.wohngeld_verordnung::PauschalArt, betrag: Money) kind institutional {
    label de official "abzusetzender Pauschbetrag (§ 9 Absatz 2 Satz 2, § 6 Absatz 2 WoGV)";
    label en unofficial "lump sum deducted";
}

relation dritte_zuschlag(mv: de.social.wohngeld_verordnung::Mietverhaeltnis, kennung: Integer, betrag: Money) kind institutional {
    label de official "zur Miete gehörende Zahlung an Dritte (§ 2 Absatz 1 WoGV)";
    label en unofficial "third-party payment added to the rent";
}

@source(WOGG_9_ABS2_ED2023, WOGG_9_ABS2_ED2025, WOGG_9_ABS2_ED2026, "urn:de:social:clir:wohngeld-verordnung#WOGV_6_ABS1")
rule UmlageAbzug(mv: de.social.wohngeld_verordnung::Mietverhaeltnis, pos: de.social.wohngeld_verordnung::BetriebskostenPosition, art: de.social.wohngeld_verordnung::KostenartNeunZwei, b: Money) strict {
    label de official "§ 9 Absatz 2 Nummer 1, 2 mit § 6 Absatz 1 WoGV: Heiz- und Warmwasserumlagen bleiben außer Betracht";
    label en unofficial "heating and hot-water charges are disregarded";
    when de.social.wohngeld_verordnung::ausser_betracht_bleibende_umlage(mv, pos, art, b);
    then umlage_abzug(mv, pos, b);
}

@source(WOGG_9_ABS2_ED2023, WOGG_9_ABS2_ED2025, WOGG_9_ABS2_ED2026)
rule KostenAbzug(mv: de.social.wohngeld_verordnung::Mietverhaeltnis, art: de.social.wohngeld_verordnung::KostenartNeunZwei, b: Money) strict {
    label de official "§ 9 Absatz 2 Satz 1: ausgewiesene Kosten und Vergütungen bleiben außer Betracht";
    label en unofficial "shown costs are disregarded";
    when ausgewiesene_kosten_9_abs2(mv, art, b);
    then kosten_abzug(mv, art, b);
}

@source(WOGG_9_ABS2_ED2023, WOGG_9_ABS2_ED2025, WOGG_9_ABS2_ED2026, "urn:de:social:clir:wohngeld-verordnung#WOGV_6_ABS2")
rule PauschbetragAbzug(mv: de.social.wohngeld_verordnung::Mietverhaeltnis, art: de.social.wohngeld_verordnung::PauschalArt, b: Money) strict {
    label de official "§ 9 Absatz 2 Satz 2: ergeben sich die Beträge nicht aus dem Mietvertrag, sind Pauschbeträge abzusetzen";
    label en unofficial "lump sums are deducted where amounts are not shown";
    when de.social.wohngeld_verordnung::pauschbetrag_6_abs2(mv, art, b);
    then pauschbetrag_abzug(mv, art, b);
}

@source(WOGG_9_ABS1_ED2023, WOGG_9_ABS1_ED2025, WOGG_9_ABS1_ED2026, "urn:de:social:clir:wohngeld-verordnung#WOGV_2_ABS1")
rule DritteZuschlag(mv: de.social.wohngeld_verordnung::Mietverhaeltnis, b: Money) strict {
    label de official "§ 9 Absatz 1 mit § 2 Absatz 1 WoGV: Zahlungen an Dritte gehören zur Miete";
    label en unofficial "third-party payments form part of the rent";
    when de.social.wohngeld_verordnung::zur_miete_gehoerende_zahlung_an_dritte(mv, b);
    then dritte_zuschlag(mv, 1, b);
}

@source(WOGG_9_ABS1_ED2023, WOGG_9_ABS1_ED2025, WOGG_9_ABS1_ED2026, WOGG_9_ABS2_ED2023, WOGG_9_ABS2_ED2025, WOGG_9_ABS2_ED2026)
rule NullpostenBeiVollstaendigenAngaben(mv: de.social.wohngeld_verordnung::Mietverhaeltnis) strict {
    label de official "die Angaben zur Miete sind vollständig: übrige Betriebskosten bleiben nicht außer Betracht, weitere Kosten, Pauschbeträge und Zahlungen an Dritte sind nicht angegeben";
    label en unofficial "declared rent data complete: zero items for the remaining groups";
    when angaben_zur_miete_vollstaendig(mv);
    then umlage_abzug(mv, de.social.wohngeld_verordnung::UEBRIGE_BETRIEBSKOSTEN, 0 EUR);
}

@source(WOGG_9_ABS2_ED2023, WOGG_9_ABS2_ED2025, WOGG_9_ABS2_ED2026)
rule NullpostenKosten(mv: de.social.wohngeld_verordnung::Mietverhaeltnis) strict {
    label de official "vollständige Angaben: Nullposten ausgewiesener Kosten";
    label en unofficial "zero item for shown costs";
    when angaben_zur_miete_vollstaendig(mv);
    then kosten_abzug(mv, de.social.wohngeld_verordnung::NR5_ZUSATZLEISTUNGEN, 0 EUR);
}

@source(WOGG_9_ABS2_ED2023, WOGG_9_ABS2_ED2025, WOGG_9_ABS2_ED2026)
rule NullpostenPauschbetraege(mv: de.social.wohngeld_verordnung::Mietverhaeltnis) strict {
    label de official "vollständige Angaben: Nullposten Pauschbeträge";
    label en unofficial "zero item for lump sums";
    when angaben_zur_miete_vollstaendig(mv);
    then pauschbetrag_abzug(mv, de.social.wohngeld_verordnung::GARAGE, 0 EUR);
}

@source(WOGG_9_ABS1_ED2023, WOGG_9_ABS1_ED2025, WOGG_9_ABS1_ED2026)
rule NullpostenDritte(mv: de.social.wohngeld_verordnung::Mietverhaeltnis) strict {
    label de official "vollständige Angaben: Nullposten Zahlungen an Dritte";
    label en unofficial "zero item for third-party payments";
    when angaben_zur_miete_vollstaendig(mv);
    then dritte_zuschlag(mv, 0, 0 EUR);
}

@source(WOGG_9_ABS2_ED2023, WOGG_9_ABS2_ED2025, WOGG_9_ABS2_ED2026)
rule AbzuegeVonDerMiete(mv: de.social.wohngeld_verordnung::Mietverhaeltnis) strict {
    label de official "§ 9 Absatz 2: Summe der außer Betracht bleibenden Kosten und Vergütungen einschließlich der Pauschbeträge";
    label en unofficial "total disregarded costs";
    when angaben_zur_miete_vollstaendig(mv);
    then abzuege_von_der_miete(mv,
        sum(collect all b1: Money, p1: de.social.wohngeld_verordnung::BetriebskostenPosition where umlage_abzug(mv, p1, b1))
        + sum(collect all b2: Money, a2: de.social.wohngeld_verordnung::KostenartNeunZwei where kosten_abzug(mv, a2, b2))
        + sum(collect all b3: Money, a3: de.social.wohngeld_verordnung::PauschalArt where pauschbetrag_abzug(mv, a3, b3)));
}

@source(WOGG_9_ABS1_ED2023, WOGG_9_ABS1_ED2025, WOGG_9_ABS1_ED2026, "urn:de:social:clir:wohngeld-verordnung#WOGV_2_ABS1")
rule ZahlungenAnDritte(mv: de.social.wohngeld_verordnung::Mietverhaeltnis) strict {
    label de official "§ 2 Absatz 1 WoGV: Summe der Zahlungen an Dritte";
    label en unofficial "total third-party payments";
    when angaben_zur_miete_vollstaendig(mv);
    then zahlungen_an_dritte(mv, sum(collect all b: Money, k: Integer where dritte_zuschlag(mv, k, b)));
}

@source(WOGG_9_ABS1_ED2023, WOGG_9_ABS1_ED2025, WOGG_9_ABS1_ED2026, WOGG_9_ABS2_ED2023, WOGG_9_ABS2_ED2025, WOGG_9_ABS2_ED2026)
rule MieteNachNeun(h: Haushalt, mv: de.social.wohngeld_verordnung::Mietverhaeltnis, e: Money, d: Money, a: Money) strict {
    label de official "§ 9 Absatz 1, 2: Miete ist das vereinbarte Entgelt einschließlich Umlagen, Zuschlägen und Vergütungen abzüglich der außer Betracht bleibenden Kosten";
    label en unofficial "rent is the agreed consideration less disregarded costs";
    when mietverhaeltnis_des_haushalts(h, mv) and vereinbartes_entgelt(mv, e)
        and zahlungen_an_dritte(mv, d) and abzuege_von_der_miete(mv, a);
    then miete_nach_9(h, e + d - a);
}

// --- § 11, § 12: zu berücksichtigende Miete ---------------------------------

relation miete_aus_vertrag_grundlage(g: Nutzungsgrundlage) kind institutional {
    label de official "Nutzungsgrundlage, bei der die Miete nach § 9 Absatz 1 aus dem Vertrag zu ermitteln ist (nicht Heim, nicht Mietwert)";
    label en unofficial "basis of use where the rent is taken from the agreement";
}

@source(WOGG_9_ABS1_ED2023, WOGG_9_ABS1_ED2025, WOGG_9_ABS1_ED2026)
rule MieteAusMietvertrag strict {
    label de official "§ 9 Absatz 1: Miete aus Mietvertrag";
    label en unofficial "rent from a lease";
    then miete_aus_vertrag_grundlage(MIETVERHAELTNIS);
}

@source(WOGG_9_ABS1_ED2023, WOGG_9_ABS1_ED2025, WOGG_9_ABS1_ED2026)
rule MieteAusMietaehnlichemNutzungsverhaeltnis strict {
    label de official "§ 9 Absatz 1: Miete aus ähnlichem Nutzungsverhältnis";
    label en unofficial "rent from a tenancy-like agreement";
    then miete_aus_vertrag_grundlage(MIETAEHNLICHES_NUTZUNGSVERHAELTNIS);
}

@source(WOGG_12_ABS1_ED2023, WOGG_12_ABS1_ED2025, WOGG_12_ABS1_ED2026, WOGG_12_ABS7_ED2023, WOGG_12_ABS7_ED2025, WOGG_12_ABS7_ED2026, WOGG_11_ABS3_ED2023, WOGG_11_ABS3_ED2025, WOGG_11_ABS3_ED2026)
rule HoechstbetragMitKlimakomponente(h: Haushalt, s: Mietenstufe, gesamt: Integer) strict {
    label de official "§ 12 Absatz 1 und 7 mit Anlage 1: Höchstbetrag und Klimakomponente nach der Mietenstufe und der Gesamtzahl der Haushaltsmitglieder (§ 11 Absatz 3 Satz 3)";
    label en unofficial "maximum amount and climate component by rent level and total members";
    when mietenstufe(h, s) and gesamtzahl_haushaltsmitglieder(h, gesamt) and gesamt >= 1;
    then hoechstbetrag_mit_klimakomponente(h, hoechstbetrag(gesamt, s) + klimakomponente_betrag(gesamt));
}

@source(WOGG_12_ABS6_ED2023, WOGG_12_ABS6_ED2025, WOGG_12_ABS6_ED2026, WOGG_11_ABS3_ED2023, WOGG_11_ABS3_ED2025, WOGG_11_ABS3_ED2026)
rule Heizkostenentlastung(h: Haushalt, gesamt: Integer) strict {
    label de official "§ 12 Absatz 6: Gesamtbetrag zur Entlastung bei den Heizkosten nach der Gesamtzahl der Haushaltsmitglieder";
    label en unofficial "heating cost relief by total members";
    when gesamtzahl_haushaltsmitglieder(h, gesamt) and gesamt >= 1;
    then heizkostenentlastung(h, heizkostenentlastung_betrag(gesamt));
}

@source(WOGG_11_ABS1_ED2023, WOGG_11_ABS1_ED2025, WOGG_11_ABS1_ED2026, WOGG_11_ABS3_ED2023, WOGG_11_ABS3_ED2025, WOGG_11_ABS3_ED2026)
rule ZuBeruecksichtigendeMiete(h: Haushalt, p: de.tax.income_for_wohngeld::Person, g: Nutzungsgrundlage,
                               m: Money, hk: Money, e: Money, n: Integer, gesamt: Integer) strict {
    label de official "§ 11 Absatz 1 Satz 1, Absatz 3: Miete bis zur Summe aus Höchstbetrag und Klimakomponente zuzüglich Heizkostenentlastung, bei ausgeschlossenen Haushaltsmitgliedern anteilig";
    label en unofficial "rent capped at maximum plus climate component, plus heating relief, pro rata if members are excluded";
    when wohngeldberechtigt(h, p) and nutzungsgrundlage(h, p, g) and mietzuschuss_grundlage(g)
        and miete_aus_vertrag_grundlage(g)
        and miete_nach_9(h, m) and hoechstbetrag_mit_klimakomponente(h, hk) and heizkostenentlastung(h, e)
        and anzahl_zu_beruecksichtigende_haushaltsmitglieder(h, n) and n >= 1
        and gesamtzahl_haushaltsmitglieder(h, gesamt);
    then zu_beruecksichtigende_miete(h, anteil(min(m, hk) + e, n, gesamt));
}

@source(WOGG_9_ABS3_ED2023, WOGG_9_ABS3_ED2025, WOGG_9_ABS3_ED2026, WOGG_11_ABS1_ED2023, WOGG_11_ABS1_ED2025, WOGG_11_ABS1_ED2026, WOGG_11_ABS3_ED2023, WOGG_11_ABS3_ED2025, WOGG_11_ABS3_ED2026, WOGG_3_ABS1_ED2023, WOGG_3_ABS1_ED2025, WOGG_3_ABS1_ED2026)
rule ZuBeruecksichtigendeMieteImHeim(h: Haushalt, p: de.tax.income_for_wohngeld::Person, hk: Money, e: Money,
                                     n: Integer, gesamt: Integer) strict {
    label de official "§ 9 Absatz 3 Satz 2, § 11 Absatz 1 Satz 2: im Heim ist die Summe aus Höchstbetrag, Heizkostenentlastung und Klimakomponente zu berücksichtigen";
    label en unofficial "care home residents: maximum amount plus heating relief and climate component";
    when wohngeldberechtigt(h, p) and nutzungsgrundlage(h, p, HEIM)
        and hoechstbetrag_mit_klimakomponente(h, hk) and heizkostenentlastung(h, e)
        and anzahl_zu_beruecksichtigende_haushaltsmitglieder(h, n) and n >= 1
        and gesamtzahl_haushaltsmitglieder(h, gesamt);
    then zu_beruecksichtigende_miete(h, anteil(hk + e, n, gesamt));
}
