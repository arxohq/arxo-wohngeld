// §§ 9, 11, 12 WoGG: Miete, zu berücksichtigende Miete, Höchstbeträge,
// Heizkostenentlastung und Klimakomponente, Mietenstufen.
//
// ОДНА ФОРМУЛА ДОЛИ ВМЕСТО ЧЕТЫРЁХ. § 11 Abs. 3 велит брать долю Miete, долю
// Höchstbetrag, долю Heizkostenentlastung и долю Klimakomponente по отношению
// числа учитываемых членов к Gesamtzahl. Доля линейна: min(d·Miete, d·(HB+K)) +
// d·H = d·(min(Miete, HB+K) + H). Деление на Gesamtzahl может быть неточным
// (2/3), и текст округления здесь не называет; величина M входит в формулу
// § 19, где Anlage 3 Nr. 2 велит считать «als Festkommazahlen mit zehn
// Nachkommastellen». Поэтому доля считается `div_round(…, 10, "HALF_UP")` —
// это ПРОЧТЕНИЕ (коммерческое округление при переходе к фиксированной точке),
// оно названо в README и проверено мутацией.
//
// Höchstbetrag, Heizkosten- и Klimakomponente при числе членов сверх пяти —
// значение для пяти плюс «Mehrbetrag für jedes weitere» (Anlage 1, § 12 Abs. 6,
// 7). По § 11 Abs. 3 S. 3 все три определяются по ГЕСАМТЗАЛЬ членов.

language "law.core" version "0.2";
package de.social.wohngeld version "0.1.0";
namespace "urn:de:social:clir:wohngeld";

use self::{
    Haushalt,
    Nutzungsgrundlage,
    WOGG_11_ABS1_ED2023,
    WOGG_11_ABS1_ED2025,
    WOGG_11_ABS1_ED2026,
    WOGG_11_ABS3_ED2023,
    WOGG_11_ABS3_ED2025,
    WOGG_11_ABS3_ED2026,
    WOGG_12_ABS1_ED2023,
    WOGG_12_ABS1_ED2025,
    WOGG_12_ABS1_ED2026,
    WOGG_12_ABS4A_ED2023,
    WOGG_12_ABS4A_ED2025,
    WOGG_12_ABS4A_ED2026,
    WOGG_12_ABS5_ED2023,
    WOGG_12_ABS5_ED2025,
    WOGG_12_ABS5_ED2026,
    WOGG_12_ABS6_ED2023,
    WOGG_12_ABS6_ED2025,
    WOGG_12_ABS6_ED2026,
    WOGG_12_ABS7_ED2023,
    WOGG_12_ABS7_ED2025,
    WOGG_12_ABS7_ED2026,
    WOGG_3_ABS1_ED2023,
    WOGG_3_ABS1_ED2025,
    WOGG_3_ABS1_ED2026,
    WOGG_9_ABS1_ED2023,
    WOGG_9_ABS1_ED2025,
    WOGG_9_ABS1_ED2026,
    WOGG_9_ABS2_ED2023,
    WOGG_9_ABS2_ED2025,
    WOGG_9_ABS2_ED2026,
    WOGG_9_ABS3_ED2023,
    WOGG_9_ABS3_ED2025,
    WOGG_9_ABS3_ED2026,
    anzahl_zu_beruecksichtigende_haushaltsmitglieder,
    gesamtzahl_haushaltsmitglieder,
    mietzuschuss_grundlage,
    nutzungsgrundlage,
    wohngeldberechtigt,
};

pub enum Mietenstufe {
    MIETENSTUFE_I, MIETENSTUFE_II, MIETENSTUFE_III, MIETENSTUFE_IV,
    MIETENSTUFE_V, MIETENSTUFE_VI, MIETENSTUFE_VII;
    label de official "Mietenstufe nach § 12 Absatz 5";
    label en unofficial "rent level under sec. 12(5)";
}

// --- Факты дела -------------------------------------------------------------

pub relation wohnort(h: Haushalt, land: Text, gemeinde: Text) kind empirical {
    key(h);
    label de official "Land und Gemeinde des Wohnraums in der Schreibweise der Anlage zur Wohngeldverordnung";
    label en unofficial "Land and municipality of the dwelling as spelled in the Annex";
}

pub relation wohnort_kreis(h: Haushalt, kreis: Text) kind empirical {
    key(h);
    label de official "Kreis, zu dem die Gemeinde des Wohnraums gehört, in der Schreibweise der Anlage";
    label en unofficial "district to which the municipality belongs";
}

pub relation mietverhaeltnis_des_haushalts(h: Haushalt, mv: de.social.wohngeld_verordnung::Mietverhaeltnis) kind empirical {
    key(h);
    label de official "Miet- oder Nutzungsverhältnis über den Wohnraum, für den Wohngeld beantragt wird";
    label en unofficial "tenancy of the dwelling for which housing benefit is claimed";
}

pub relation vereinbartes_entgelt(mv: de.social.wohngeld_verordnung::Mietverhaeltnis, betrag: Money) kind empirical {
    key(mv);
    label de official "vereinbartes monatliches Entgelt für die Gebrauchsüberlassung von Wohnraum einschließlich Umlagen, Zuschlägen und Vergütungen (§ 9 Absatz 1)";
    label en unofficial "agreed monthly consideration including charges and surcharges";
}

pub relation ausgewiesene_kosten_9_abs2(mv: de.social.wohngeld_verordnung::Mietverhaeltnis, art: de.social.wohngeld_verordnung::KostenartNeunZwei, betrag: Money) kind empirical {
    label de official "im Entgelt enthaltene, im Mietvertrag oder in Unterlagen ausgewiesene monatliche Kosten oder Vergütungen der bezeichneten Art (außer nach Nummern der Betriebskostenverordnung ausgewiesenen Umlagen)";
    label en unofficial "monthly costs of the given kind shown in the lease and included in the consideration";
}

pub relation angaben_zur_miete_vollstaendig(mv: de.social.wohngeld_verordnung::Mietverhaeltnis) kind empirical {
    label de official "alle im Entgelt enthaltenen Kosten nach § 9 Absatz 2 und alle Zahlungen an Dritte nach § 2 Absatz 1 WoGV sind angegeben";
    label en unofficial "all cost items under sec. 9(2) and third-party payments are declared";
}

// --- Выводимое --------------------------------------------------------------

relation insel_ohne_festlandanschluss(gemeinde: Text) kind institutional {
    label de official "Gemeinde auf einer Insel ohne Festlandanschluss (§ 12 Absatz 4a)";
    label en unofficial "municipality on an island without mainland connection";
}

relation mietenstufe_nummer(h: Haushalt, nummer: Integer) kind institutional {
    label de official "Nummer der Mietenstufe des Wohnorts nach der Anlage zur Wohngeldverordnung";
    label en unofficial "number of the rent level of the place of residence";
}

pub relation mietenstufe(h: Haushalt, stufe: Mietenstufe) kind institutional {
    label de official "Mietenstufe der Gemeinde des Wohnraums (§ 12 Absatz 1, 5)";
    label en unofficial "rent level of the dwelling's municipality";
}

relation abzuege_von_der_miete(mv: de.social.wohngeld_verordnung::Mietverhaeltnis, betrag: Money) kind institutional {
    label de official "Summe der nach § 9 Absatz 2 außer Betracht bleibenden Kosten und Vergütungen einschließlich der Pauschbeträge nach § 6 Absatz 2 WoGV";
    label en unofficial "total of costs disregarded under sec. 9(2)";
}

relation zahlungen_an_dritte(mv: de.social.wohngeld_verordnung::Mietverhaeltnis, betrag: Money) kind institutional {
    label de official "Summe der zur Miete gehörenden Zahlungen an Dritte (§ 2 Absatz 1 WoGV)";
    label en unofficial "total third-party payments forming part of the rent";
}

pub relation miete_nach_9(h: Haushalt, betrag: Money) kind institutional {
    label de official "Miete nach § 9 (monatlich)";
    label en unofficial "rent under sec. 9 (monthly)";
}

pub relation hoechstbetrag_mit_klimakomponente(h: Haushalt, betrag: Money) kind institutional {
    label de official "Summe aus dem Höchstbetrag nach § 12 Absatz 1 und der Klimakomponente nach § 12 Absatz 7 für die Gesamtzahl der Haushaltsmitglieder";
    label en unofficial "maximum amount plus climate component for the total number of members";
}

pub relation heizkostenentlastung(h: Haushalt, betrag: Money) kind institutional {
    label de official "Gesamtbetrag zur Entlastung bei den Heizkosten nach § 12 Absatz 6 für die Gesamtzahl der Haushaltsmitglieder";
    label en unofficial "heating cost relief for the total number of members";
}

pub relation zu_beruecksichtigende_miete(h: Haushalt, betrag: Money) kind institutional {
    label de official "zu berücksichtigende monatliche Miete „M“ (§ 11)";
    label en unofficial "monthly rent to be taken into account (M)";
}

// --- § 12 Abs. 4a -----------------------------------------------------------

