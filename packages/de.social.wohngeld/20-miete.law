// --- § 12 Abs. 1, 4a, 5 и Anlage WoGV: Mietenstufe --------------------------

@source(WOGG_12_ABS1_ED2023, WOGG_12_ABS1_ED2025, WOGG_12_ABS1_ED2026, "urn:de:social:clir:wohngeld-verordnung#WOGV_1_ABS3")
rule AnlageFuerWohnortAnwenden(h: Haushalt, land: Text, gemeinde: Text) strict {
    label de official "§ 12 Absatz 1: die Mietenstufe ergibt sich für die Gemeinde des Wohnraums aus der Anlage zur Wohngeldverordnung";
    label en unofficial "the Annex is applied to the municipality of the dwelling";
    when wohnort(h, land, gemeinde);
    then de.social.wohngeld_verordnung::mietenstufe_anfrage(land, gemeinde);
}

@source(WOGG_12_ABS1_ED2023, WOGG_12_ABS1_ED2025, WOGG_12_ABS1_ED2026, "urn:de:social:clir:wohngeld-verordnung#WOGV_ANLAGE_VORBEMERKUNG")
rule AnlageFuerKreisAnwenden(h: Haushalt, land: Text, gemeinde: Text, kreis: Text) strict {
    label de official "Anlage zur WoGV, Vorbemerkung: für eine nicht gesondert aufgeführte Gemeinde ist die Tabelle der Kreise anzuwenden";
    label en unofficial "the district table is applied for the dwelling's district";
    when wohnort(h, land, gemeinde) and wohnort_kreis(h, kreis);
    then de.social.wohngeld_verordnung::mietenstufe_anfrage_kreis(land, kreis);
}

@source(WOGG_12_ABS1_ED2023, WOGG_12_ABS1_ED2025, WOGG_12_ABS1_ED2026, "urn:de:social:clir:wohngeld-verordnung#WOGV_1_ABS3")
rule MietenstufeGesondertAufgefuehrteGemeinde(h: Haushalt, land: Text, gemeinde: Text, n: Integer) strict {
    label de official "§ 12 Absatz 1 mit § 1 Absatz 3 WoGV: Mietenstufe der in der Anlage gesondert aufgeführten Gemeinde";
    label en unofficial "rent level of a separately listed municipality";
    when wohnort(h, land, gemeinde) and de.social.wohngeld_verordnung::mietenstufe_gemeinde(land, gemeinde, n);
    then mietenstufe_nummer(h, n);
}

@source(WOGG_12_ABS1_ED2023, WOGG_12_ABS1_ED2025, WOGG_12_ABS1_ED2026, "urn:de:social:clir:wohngeld-verordnung#WOGV_ANLAGE_VORBEMERKUNG")
rule MietenstufeDesKreises(h: Haushalt, land: Text, gemeinde: Text, kreis: Text, n: Integer) strict {
    label de official "Anlage zur WoGV, Vorbemerkung: soweit die zu einem Kreis gehörenden Gemeinden nicht gesondert aufgeführt sind, gilt die Mietenstufe des Kreises";
    label en unofficial "a municipality not listed separately takes the rent level of its district";
    when wohnort(h, land, gemeinde) and wohnort_kreis(h, kreis)
        and not_known(de.social.wohngeld_verordnung::gemeinde_gesondert_aufgefuehrt(land, gemeinde))
        and not_known(insel_ohne_festlandanschluss(gemeinde))
        and de.social.wohngeld_verordnung::mietenstufe_kreis(land, kreis, n);
    then mietenstufe_nummer(h, n);
}

@source(WOGG_12_ABS4A_ED2023, WOGG_12_ABS4A_ED2025, WOGG_12_ABS4A_ED2026, "urn:de:social:clir:wohngeld-verordnung#WOGV_ANLAGE_INSELN_GEMEINSAM")
rule MietenstufeInselnOhneFestlandanschluss(h: Haushalt, land: Text, gemeinde: Text, n: Integer) strict {
    label de official "§ 12 Absatz 4a: gemeinsame Mietenstufenzuordnung der Inseln ohne Festlandanschluss";
    label en unofficial "joint rent level of islands without mainland connection";
    when wohnort(h, land, gemeinde) and insel_ohne_festlandanschluss(gemeinde)
        and de.social.wohngeld_verordnung::mietenstufe_gemeinsam("Inseln ohne Festlandanschluss", n);
    then mietenstufe_nummer(h, n);
}

@source(WOGG_12_ABS5_ED2023, WOGG_12_ABS5_ED2025, WOGG_12_ABS5_ED2026)
rule MietenstufeNummer1IstStufeI(h: Haushalt, n: Integer) strict {
    label de official "§ 12 Absatz 5: Mietenstufe I";
    label en unofficial "sec. 12(5): rent level I";
    when mietenstufe_nummer(h, n) and n == 1;
    then mietenstufe(h, MIETENSTUFE_I);
}

@source(WOGG_12_ABS5_ED2023, WOGG_12_ABS5_ED2025, WOGG_12_ABS5_ED2026)
