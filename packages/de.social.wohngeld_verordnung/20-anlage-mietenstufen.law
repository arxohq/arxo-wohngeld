    WOGV_ANLAGE_BY_KREIS,
    WOGV_ANLAGE_HB_GEMEINDE,
    WOGV_ANLAGE_HE_GEMEINDE,
    WOGV_ANLAGE_HE_KREIS,
    WOGV_ANLAGE_HH_GEMEINDE,
    WOGV_ANLAGE_INSELN_GEMEINSAM,
    WOGV_ANLAGE_MV_GEMEINDE,
    WOGV_ANLAGE_MV_KREIS,
    WOGV_ANLAGE_NI_GEMEINDE,
    WOGV_ANLAGE_NI_KREIS,
    WOGV_ANLAGE_NW_GEMEINDE,
    WOGV_ANLAGE_NW_KREIS,
    WOGV_ANLAGE_RP_GEMEINDE,
    WOGV_ANLAGE_RP_KREIS,
    WOGV_ANLAGE_SH_GEMEINDE,
    WOGV_ANLAGE_SH_KREIS,
    WOGV_ANLAGE_SL_GEMEINDE,
    WOGV_ANLAGE_SL_KREIS,
    WOGV_ANLAGE_SN_GEMEINDE,
    WOGV_ANLAGE_SN_KREIS,
    WOGV_ANLAGE_ST_GEMEINDE,
    WOGV_ANLAGE_ST_KREIS,
    WOGV_ANLAGE_TH_GEMEINDE,
    WOGV_ANLAGE_TH_KREIS,
    mietenstufe_anfrage,
    mietenstufe_anfrage_kreis,
    mietenstufe_gemeinde,
    mietenstufe_gemeinsam,
    mietenstufe_kreis,
};

// ПОРОЖДЁННЫЙ ФАЙЛ. Правится только corpus/tools/sources/sync/sync_de_wohngeld.py;
// байты кладёт corpus/tools/sources/fetch/fetch_de_wohngeld_texts.py.


// Anlage (zu § 1 Absatz 3) WoGV: «Mietenstufen der Gemeinden nach Ländern ab
// 1. Januar 2023». Строки таблицы сгруппированы по (Land, раздел, ступень):
// одно правило на группу, анкер — фрагмент раздела, условие — название в
// написании Anlage. Правило срабатывает только для ЗАПРОШЕННОЙ пары
// (`mietenstufe_anfrage` — Wohnort домохозяйства, её пишет WoGG): таблица из
// 1 881 строки не материализуется целиком в каждом вычислении.
// Ступень — номер 1…7 вместо римской цифры: перечисление ступеней принадлежит
// § 12 Abs. 5 WoGG, а WoGV закон не импортирует.

@source(WOGV_ANLAGE_BW_GEMEINDE)
rule MietenstufeBWGemeindeIII(land: Text, gemeinde: Text) strict {
    label de official "Land: Baden-Württemberg — Gemeinden der Mietenstufe III (75)";
    label en unofficial "Baden-Württemberg: municipalities with rent level III (75)";
    when mietenstufe_anfrage(land, gemeinde) and land == "Baden-Württemberg"
        and (gemeinde == "Aalen, Stadt"
        or gemeinde == "Bad Dürrheim, Stadt"
        or gemeinde == "Bad Mergentheim, Stadt"
        or gemeinde == "Bad Rappenau, Stadt"
        or gemeinde == "Biberach an der Riß, Stadt"
        or gemeinde == "Birkenfeld"
        or gemeinde == "Blaubeuren, Stadt"
