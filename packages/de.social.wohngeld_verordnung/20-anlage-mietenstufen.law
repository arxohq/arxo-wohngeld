@source(WOGV_ANLAGE_TH_KREIS)
rule MietenstufeTHKreisI(land: Text, kreis: Text) strict {
    label de official "Land: Thüringen — Kreise der Mietenstufe I (16)";
    label en unofficial "Thüringen: districts with rent level I (16)";
    when mietenstufe_anfrage_kreis(land, kreis) and land == "Thüringen"
        and (kreis == "Eichsfeld"
        or kreis == "Nordhausen"
        or kreis == "Wartburgkreis"
        or kreis == "Unstrut-Hainich-Kreis"
        or kreis == "Kyffhäuserkreis"
        or kreis == "Schmalkalden-Meiningen"
        or kreis == "Gotha"
        or kreis == "Sömmerda"
        or kreis == "Hildburghausen"
        or kreis == "Ilm-Kreis"
        or kreis == "Sonneberg"
        or kreis == "Saalfeld-Rudolstadt"
        or kreis == "Saale-Holzland-Kreis"
        or kreis == "Saale-Orla-Kreis"
        or kreis == "Greiz"
        or kreis == "Altenburger Land");
    then mietenstufe_kreis(land, kreis, 1);
}

@source(WOGV_ANLAGE_TH_KREIS)
rule MietenstufeTHKreisII(land: Text, kreis: Text) strict {
    label de official "Land: Thüringen — Kreise der Mietenstufe II (1)";
    label en unofficial "Thüringen: districts with rent level II (1)";
    when mietenstufe_anfrage_kreis(land, kreis) and land == "Thüringen"
        and (kreis == "Weimarer Land");
    then mietenstufe_kreis(land, kreis, 2);
}

@source(WOGV_ANLAGE_INSELN_GEMEINSAM)
rule MietenstufeInselnOhneFestlandanschluss strict {
    label de official "Gemeinsame Mietenstufe: Inseln ohne Festlandanschluss | V";
