        or gemeinde == "Gera, Stadt"
        or gemeinde == "Greiz, Stadt"
        or gemeinde == "Hildburghausen, Stadt"
        or gemeinde == "Leinefelde-Worbis"
        or gemeinde == "Mühlhausen/Thüringen, Stadt"
        or gemeinde == "Schmalkalden, Kurort, Stadt"
        or gemeinde == "Schmölln, Stadt"
        or gemeinde == "Sonneberg, Stadt"
        or gemeinde == "Waltershausen, Stadt"
        or gemeinde == "Zeulenroda Triebes, Stadt");
    then mietenstufe_gemeinde(land, gemeinde, 1);
}

@source(WOGV_ANLAGE_TH_GEMEINDE)
rule MietenstufeTHGemeindeII(land: Text, gemeinde: Text) strict {
    label de official "Land: Thüringen — Gemeinden der Mietenstufe II (15)";
    label en unofficial "Thüringen: municipalities with rent level II (15)";
    when mietenstufe_anfrage(land, gemeinde) and land == "Thüringen"
        and (gemeinde == "Arnstadt, Stadt"
        or gemeinde == "Eisenach, Stadt"
        or gemeinde == "Gotha, Stadt"
        or gemeinde == "Heilbad Heiligenstadt, Stadt"
        or gemeinde == "Ilmenau, Stadt"
        or gemeinde == "Meiningen, Stadt"
        or gemeinde == "Nordhausen, Stadt"
        or gemeinde == "Pößneck, Stadt"
        or gemeinde == "Rudolstadt, Stadt"
        or gemeinde == "Saalfeld/Saale, Stadt"
        or gemeinde == "Schleusingen, Stadt"
        or gemeinde == "Sömmerda, Stadt"
        or gemeinde == "Sondershausen, Stadt"
        or gemeinde == "Suhl, Stadt"
        or gemeinde == "Zella-Mehlis, Stadt");
    then mietenstufe_gemeinde(land, gemeinde, 2);
}

