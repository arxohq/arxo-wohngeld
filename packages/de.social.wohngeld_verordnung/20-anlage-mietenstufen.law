        or gemeinde == "Gengenbach, Stadt"
        or gemeinde == "Gernsbach, Stadt"
        or gemeinde == "Göppingen, Stadt"
        or gemeinde == "Gottmadingen"
        or gemeinde == "Graben-Neudorf"
        or gemeinde == "Heddesheim"
        or gemeinde == "Hemsbach, Stadt"
        or gemeinde == "Herbolzheim, Stadt"
        or gemeinde == "Hockenheim, Stadt"
        or gemeinde == "Isny im Allgäu, Stadt"
        or gemeinde == "Karlsbad"
        or gemeinde == "Karlsdorf-Neuthard"
        or gemeinde == "Kehl, Stadt"
        or gemeinde == "Künzelsau, Stadt"
        or gemeinde == "Lahr/Schwarzwald, Stadt"
        or gemeinde == "Laichingen, Stadt"
        or gemeinde == "Langenau, Stadt"
        or gemeinde == "Laupheim, Stadt"
        or gemeinde == "Linkenheim-Hochstetten"
        or gemeinde == "Lorch, Stadt"
        or gemeinde == "Malsch"
        or gemeinde == "Mosbach, Stadt"
        or gemeinde == "Mühlacker, Stadt"
        or gemeinde == "Neckargemünd, Stadt"
        or gemeinde == "Niefern-Öschelbronn"
        or gemeinde == "Oberderdingen"
        or gemeinde == "Obersulm"
        or gemeinde == "Offenburg, Stadt"
        or gemeinde == "Pfinztal"
        or gemeinde == "Rastatt, Stadt"
        or gemeinde == "Remshalden"
        or gemeinde == "Rottweil, Stadt"
        or gemeinde == "Salem"
        or gemeinde == "Sankt Leon-Rot"
        or gemeinde == "Schopfheim, Stadt"
        or gemeinde == "Schwäbisch Gmünd, Stadt"
        or gemeinde == "Schwäbisch Hall, Stadt"
        or gemeinde == "Schwaigern, Stadt"
        or gemeinde == "Sinsheim, Stadt"
        or gemeinde == "Spaichingen, Stadt"
        or gemeinde == "Stutensee, Stadt"
        or gemeinde == "Süßen, Stadt"
        or gemeinde == "Teningen"
        or gemeinde == "Ubstadt-Weiher"
        or gemeinde == "Uhingen, Stadt"
