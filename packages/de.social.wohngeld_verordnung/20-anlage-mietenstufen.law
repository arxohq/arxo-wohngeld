language "law.core" version "0.2";
package de.social.wohngeld_verordnung version "0.1.0";
namespace "urn:de:social:clir:wohngeld-verordnung";

use self::{
    WOGV_ANLAGE_BB_GEMEINDE,
    WOGV_ANLAGE_BB_KREIS,
    WOGV_ANLAGE_BE_GEMEINDE,
    WOGV_ANLAGE_BW_GEMEINDE,
    WOGV_ANLAGE_BW_KREIS,
