test "WoGV-13 Garage 36 EUR, Zahlung an Dritte gehoert zur Miete" {
    given {
        context { legal_time @2025-01-01; decision_time @2025-01-01T09:00:00Z; knowledge_time @2025-01-01T09:00:00Z; timezone "Europe/Berlin"; }
        assert "f0": nicht_ausgewiesene_kosten(entity_ref("urn:de:example:wogv:mv"), GARAGE) { origin case_input; }
        assert "f1": zahlung_an_dritte(entity_ref("urn:de:example:wogv:mv"), 15.00 EUR) { origin case_input; }
    }
    evaluate truth(pauschbetrag_6_abs2(entity_ref("urn:de:example:wogv:mv"), GARAGE, 36 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(zur_miete_gehoerende_zahlung_an_dritte(entity_ref("urn:de:example:wogv:mv"), 15.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

