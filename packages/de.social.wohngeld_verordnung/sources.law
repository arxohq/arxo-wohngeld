language "law.core" version "0.2";
package de.social.wohngeld_verordnung version "0.1.0";
namespace "urn:de:social:clir:wohngeld-verordnung";

// ПОРОЖДЁННЫЙ ФАЙЛ. Правится только corpus/tools/sources/sync/sync_de_wohngeld.py;
// байты кладёт corpus/tools/sources/fetch/fetch_de_wohngeld_texts.py.


// WoGV — постановление Федерального правительства (§ 38 WoGG). Сводный текст
// портала (build 2026-05-06, «zuletzt geändert durch Art. 2 V v. 21.10.2024 I
// Nr. 314») — одна редакция с окном [01.01.2023, ∞): моделируемые §§ 1, 2, 6 и
// Anlage с 01.01.2023 не менялись. Anlage в редакции Art. 5 Wohngeld-Plus-Gesetz
// с 13. ÄndVO (действует «mit Wirkung vom 1. Januar 2023»); 2. WoGFV Art. 2
// тронула только оглавление, § 20 и Teil 5. Генератор сверил 1 881 строку
// Anlage портала с первичным текстом двух выпусков BGBl.

source WOGV {
    kind regulation;
    jurisdiction DE;
    number "BGBl. I 2001 S. 2722";
    label de official "Wohngeldverordnung (WoGV)";
    label en unofficial "Housing Benefit Ordinance (WoGV)";
}

edition WOGV_ED2023 of WOGV {
    language de;
    officiality official;
    materialization_status PINNED_UNOFFICIAL_COPY;
    adopted @2001-10-19;
    in_force [@2023-01-01, infinity);
    label de official "Wohngeldverordnung in der Fassung der Bekanntmachung vom 19. Oktober 2001, konsolidierte Fassung (gesetze-im-internet.de, zuletzt geändert durch Art. 2 V v. 21.10.2024 I Nr. 314); modellierte Vorschriften anzuwenden ab 1. Januar 2023";
    label en unofficial "Housing Benefit Ordinance, consolidated text (last amended 21.10.2024); modelled provisions applicable from 1 January 2023";
}

source WOHNGELD_PLUS_GESETZ_ART5 {
    kind statute;
    jurisdiction DE;
    number "BGBl. I 2022 S. 2160";
    label de official "Gesetz zur Erhöhung des Wohngeldes (Wohngeld-Plus-Gesetz), Artikel 5: Änderung der Wohngeldverordnung";
    label en unofficial "Housing Benefit Plus Act, Article 5 (new Annex of the Housing Benefit Ordinance)";
}

edition WPG_ART5_ED of WOHNGELD_PLUS_GESETZ_ART5 {
    language de;
    officiality official;
    materialization_status PINNED_UNOFFICIAL_COPY;
    adopted @2022-12-05;
    in_force [@2023-01-01, infinity);
    label de official "Bundesgesetzblatt Jahrgang 2022 Teil I Nr. 48, S. 2166–2210";
